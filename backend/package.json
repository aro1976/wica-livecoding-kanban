{
  "name": "kanban-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend local (Express + in-memory) do Kanban Board",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "3.1152.0",
    "@aws-sdk/client-dynamodb": "3.1152.0",
    "@aws-sdk/lib-dynamodb": "3.1152.0",
    "@vendia/serverless-express": "4.10.1",
    "cors": "2.8.5",
    "express": "4.21.2",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.146",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "20.14.10",
    "@types/uuid": "9.0.8",
    "tsx": "4.19.2",
    "typescript": "5.5.4",
    "vitest": "2.1.8"
  }
